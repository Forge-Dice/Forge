{
  "name": "forge-deny-other-branches",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "~ALL"
      ],
      "exclude": [
        "refs/heads/main",
        "refs/heads/forge/run/codex/**/*",
        "refs/heads/forge/owner/**/*",
        "refs/heads/forge/contract/**/*"
      ]
    }
  },
  "rules": [
    {
      "type": "creation"
    },
    {
      "type": "update",
      "parameters": {
        "update_allows_fetch_and_merge": false
      }
    }
  ]
}
