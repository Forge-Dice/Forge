      "reports": []
    },
    {
      "evidenceId": "evidence:festvideo",
      "text": "Festival video, timestamp 15:00:00: Mayor Hübner stands at the lectern and has been speaking for ten minutes about the importance of the pumpkin for the village community. There is no end in sight.",
