  "entries": [
    {
      "evidenceId": "evidence:schaltprotokoll",
      "text": "The lamp switch is set to manual. The switching log: 02:00:00 switched off by hand, 02:20 automatically back on. Twenty minutes of darkness, enough for the “Greta”.",
      "mentions": [
        {
          "kind": "location",
          "id": "location:laterne"
        },
        {
          "kind": "item",
          "id": "item:schalter"
        }
      ],
      "reports": []
    },
    {
      "evidenceId": "evidence:pfeife",
      "text": "Next to the lamp lies a meerschaum pipe with the initials H. P., and beside it a key ring with the tower key. Hinrich Paulsen smokes exactly this pipe. When it was put down here, it does not reveal.",
      "mentions": [
        {
          "kind": "person",
          "id": "person:hinrich"
        },
        {
          "kind": "location",
          "id": "location:laterne"
        }
      ],
      "reports": []
    },
    {
      "evidenceId": "evidence:sandspuren",
      "text": "Wet, coarse sand with shell fragments sticks to the steps of the spiral staircase. Sand like this is found only on the west beach, not at the harbour and not on the dike.",
      "mentions": [
        {
          "kind": "location",
          "id": "location:strand"
        }
      ],
      "reports": []
    },
    {
      "evidenceId": "evidence:schlauchboot",
      "text": "A strange inflatable dinghy lies half in the mud. In the waterproof boat logbook, the last entry, with a GPS timestamp: “00:40, landed West Beach Süderhörn, K. Sievers.” So Knut Sievers was on the island that night.",
      "mentions": [
        {
          "kind": "person",
          "id": "person:knut"
        },
        {
          "kind": "location",
          "id": "location:strand"
        },
        {
          "kind": "event",
          "id": "event:landung"
        }
      ],
      "reports": [
        {
          "claim": {
            "kind": "personAt",
            "personId": "person:knut",
            "locationId": "location:strand",
            "at": 2400
          },
          "stance": "affirms",
          "source": {
            "kind": "observation"
          }
        }
      ]
    },
    {
      "evidenceId": "evidence:visitenkarte",
      "text": "Stuck in the sand next to the boat is a soaked business card: “Jasper Kühl, Assessor, Hansa Shipping Company”. On the back, in pencil: “01:00, here.”",
      "mentions": [
        {
          "kind": "person",
          "id": "person:jasper"
        },
        {
          "kind": "location",
          "id": "location:strand"
        }
      ],
      "reports": []
    },
    {
      "evidenceId": "evidence:kassenbuch",
      "text": "The ferry house cash book, in Frauke's round handwriting. Last entry: 01:45, Hinrich Paulsen, two grogs, on his tab. Behind the bar stands the telephone; it records every call.",
      "mentions": [
        {
          "kind": "person",
          "id": "person:hinrich"
        },
        {
          "kind": "location",
          "id": "location:faehrhaus"
