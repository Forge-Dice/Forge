  "questionTexts": [
    {
      "npc": "person:hinrich",
      "questionId": "question:q04",
      "text": "Läuft die Kamera am Hafen auch nachts?"
    },
    {
      "npc": "person:hinrich",
      "questionId": "question:q05",
      "text": "Waren Sie um 02:00 im Laternenraum?"
    },
    {
      "npc": "person:frauke",
      "questionId": "question:q03",
      "text": "Haben Sie um 02:00 telefoniert?"
    },
    {
      "npc": "person:frauke",
      "questionId": "question:q05",
      "text": "War Hinrich Paulsen um 02:00 im Laternenraum?"
    },
    {
      "npc": "person:ole",
      "questionId": "question:q01",
      "text": "Lag heute Nacht ein fremdes Boot an der Hallig?"
    },
    {
      "npc": "person:ole",
      "questionId": "question:q02",
      "text": "Waren Sie um 02:00 zu Hause?"
    },
    {
      "npc": "person:marlene",
      "questionId": "question:q08",
      "text": "Waren Sie um 02:00 in der Vogelwarte?"
    },
    {
      "npc": "person:marlene",
      "questionId": "question:q05",
      "text": "War Hinrich Paulsen um 02:00 im Laternenraum?"
    },
    {
      "npc": "person:jasper",
      "questionId": "question:q06",
      "text": "Waren Sie um 01:00 am Weststrand?"
    },
    {
      "npc": "person:jasper",
      "questionId": "question:q09",
      "text": "Haben Sie um 02:03 vom Fährhaus aus die Küstenwache angerufen?"
    },
    {
      "npc": "person:knut",
      "questionId": "question:q07",
      "text": "Waren Sie um 02:00 im Laternenraum?"
    }
