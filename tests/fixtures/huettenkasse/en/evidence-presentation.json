          }
        }
      ]
    },
    {
      "evidenceId": "evidence:funkbuch",
      "text": "On the table in the radio room lies the radio logbook, next to a cold cup of tea. The last entry breaks off mid-sentence; the radio itself stores every connection.",
      "mentions": [
